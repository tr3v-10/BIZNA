PORT=3000

# Who runs this installation. Shown on the Terms and Privacy pages.
OPERATOR_NAME=Your business or name
CONTACT_EMAIL=you@example.com
TERMS_EFFECTIVE_DATE=15 October 2026

# Leave false for local use and plain-http networks.
# Set true only when Bizna is served over HTTPS.
FORCE_HTTPS=false

# Set to 1 when running behind a reverse proxy (Render, Railway, Nginx, Caddy).
# TRUST_PROXY=1

# Only needed if the frontend is served from a different origin than the API.
# CORS_ORIGIN=https://app.example.com

# Move the database file if you want it outside the project folder.
# BIZNA_DB=/var/data/bizna.db
